# Required: OpenAI API Key with realtime model access
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Voice selection (default: ash)
# Options: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
VOICE_AGENT_VOICE=ash

# Optional: Audio format (default: pcm16)
# Options: pcm16, g711_ulaw, g711_alaw
VOICE_AGENT_AUDIO_FORMAT=pcm16

# Optional: VAD type (default: semantic_vad)
# Options: server_vad, semantic_vad
VOICE_AGENT_VAD_TYPE=semantic_vad

# Optional: Log level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
VOICE_AGENT_LOG_LEVEL=INFO

# Optional: Log file path (default: stdout only)
# VOICE_AGENT_LOG_FILE=/path/to/voice_agent.log
